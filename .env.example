# =============================================================================
# LinkedIn & X Content Management System - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual API keys and credentials
# Never commit the .env file to version control!

# =============================================================================
# AI/LLM Services
# =============================================================================

# DeepSeek API (Primary AI service for content generation)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter API (Alternative AI service - optional)
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# Content Sources
# =============================================================================

# FireCrawl API (Web scraping service)
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# GitHub Personal Access Token
# Create at: GitHub Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# =============================================================================
# LinkedIn API Configuration
# =============================================================================

# LinkedIn Developer App credentials
# Create app at: https://developer.linkedin.com/
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_USER_ID=your_linkedin_user_id_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here

# =============================================================================
# X (Twitter) API Configuration
# =============================================================================

# X Developer App credentials (V2 API)
# Create at: https://developer.x.com/
X_API_KEY=your_x_api_key_here
X_API_KEY_SECRET=your_x_api_key_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# =============================================================================
# Notion Integration
# =============================================================================

# Notion Integration Token
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# Notion Database IDs (create these databases in your Notion workspace)
NEWS_ARTICLE_DATABASE_ID=your_news_database_id_here
DATABASE_ID=your_news_database_id_here # Alias for NEWS_ARTICLE_DATABASE_ID
LINKEDIN_POSTS_DATABASE_ID=your_linkedin_posts_database_id_here
X_POSTS_DATABASE_ID=your_x_posts_database_id_here
GITHUB_DATABASE_ID=your_github_database_id_here

# =============================================================================
# System Configuration
# =============================================================================

# Set to true to skip actual publishing while testing
DRY_RUN=false

# =============================================================================
# Optional Configuration
# =============================================================================

# GitHub App Configuration (alternative to personal access token)
# GITHUB_APP_ID=your_github_app_id
# GITHUB_APP_PRIVATE_KEY=your_github_app_private_key
# GITHUB_REPOSITORY=your_repository_name